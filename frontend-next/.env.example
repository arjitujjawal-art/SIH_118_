# Rakshak Frontend Environment Configuration

# For local development (leave empty to use Next.js /api proxy to http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=

# When deploying frontend on Vercel and backend on Render/Railway:
# BACKEND_URL=https://your-backend-service.onrender.com
# NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com
